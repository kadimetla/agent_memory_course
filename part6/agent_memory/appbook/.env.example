# Copy to .env (or rely on the workshop's existing ../.env / ../../.env).
# Only OPENAI_API_KEY is required.

OPENAI_API_KEY=sk-...

# LLM + embeddings — same choices as the companion notebook.
AMEM_MODEL=gpt-5.6-luna
AMEM_MAX_TOKENS=1024
AMEM_EMBED_MODEL=text-embedding-3-small
AMEM_EMBED_DIMENSIONS=256

# Oracle AI Database (optional). The dedicated MEMORIZZ schema keeps its 256d
# memory vectors separate from the maturity module's 768d ACME_DOCS table. If
# Oracle is unavailable, the app uses its exact-search FileSystemProvider.
# Set ORACLE_ENABLED=0 to skip the connection attempt entirely.
ORACLE_ENABLED=1
ORACLE_USER=MEMORIZZ
ORACLE_PASSWORD=MemorizzPwd_2026
ORACLE_DSN=localhost:1521/FREEPDB1

# Where the FileSystemProvider fallback stores its data (default: appbook/.data/memorizz)
# AMEM_FS_ROOT=.data/memorizz
